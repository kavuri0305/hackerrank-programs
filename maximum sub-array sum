#include <stdio.h>

int main() {
    int n; 
    scanf("%d", &n);
    int arr[n];
    for(int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    
    int max = arr[0];
    int current = arr[0];
    
    for(int i = 1; i < n; i++) {
        if (max+arr[i] > arr[i]) {
            max += arr[i];
        } else {
            max = arr[i];
        }
        
        if (max>current) {
            current=max;
        }
    }
    
    printf("%d", current);
    return 0;
}
