#include <stdio.h>
#include <stdlib.h>

int main()
{
    int dividend, divisor;
    scanf("%d%d", &dividend, &divisor);

    if (divisor == 0)
    {
        printf("Division by zero");
        return 0;
    }

    int is_negative = 0;

    if ((dividend < 0 && divisor > 0) || (dividend > 0 && divisor < 0))
        is_negative = 1;

    int a = abs(dividend);
    int b = abs(divisor);

    int low = 0;
    int high = a;
    int quotient = 0;

    while (low <= high)
    {
        int mid = low + (high - low) / 2;

        if (mid * b <= a)
        {
            quotient = mid;
            low = mid + 1;
        }
        else
        {
            high = mid - 1;
        }
    }

    if (is_negative)
        quotient = -quotient;

    printf("%d", quotient);

    return 0;
}
