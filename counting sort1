#include<stdio.h>
int main(){
    int n;
    scanf("%d",&n);
    int arr[n];
    for(int i=0;i<n; i++){
    scanf("%d",&arr[i]);
    }
    int max=arr[0];
    int min=arr[0];
    for(int i=0; i<n; i++){
        if(arr[i]>max){
            max=arr[i];
        }
        if(arr[i]<min){
            min=arr[i];
        }
    }
    int range=max-min+1;
    int aux[range];
    for(int i=0; i<100; i++){
        aux[i]=0;
    }
    for(int i=0; i<n; i++){
        aux[arr[i]]++;
    }
    for(int i=0; i<100; i++){
        printf("%d ",aux[i]);
    }
    return 0;
}
