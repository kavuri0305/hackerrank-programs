#include<stdio.h>
int main(){
    int n;
    scanf("%d",&n);
    int arr[n];
    for(int i=0; i<n; i++){
        scanf("%d",&arr[i]);
    }
int max=arr[0];
int min=arr[0];
for( int i=0; i<n; i++){
    if(arr[i]>max){
        max=arr[i];
    }
    if(arr[i]<min){
        min=arr[i];
    }
}
int range=max-min+1;
int aux[range];
for(int i=0; i<range; i++){
    aux[i]=0;
}
for(int i=0; i<n; i++){
    aux[arr[i] - min]++;
}
int cf[range];
    cf[0] = aux[0];
    for (int i = 1; i < range; i++) {
        cf[i] = cf[i - 1] + aux[i];
    }
      int output[n];
    for (int i = n - 1; i >= 0; i--) {
        output[cf[arr[i] - min] - 1] = arr[i];
        cf[arr[i] - min]--;
    }
    for (int i = 0; i < n; i++) {
        printf("%d ", output[i]);
    }
    return 0;

}
