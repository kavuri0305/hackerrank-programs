#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    int arr[n];
    for(int i = 0; i < n; i++){
        scanf("%d", &arr[i]);
    }

    int result[n];
    for(int i = 0; i < n; i++){
        int count = 1; 
        for(int j = i + 1; j < n; j++){
          
            if(arr[i] == arr[j]){ 
                count++;
            }
        }
        result[i] = count;
    }

    int max = result[0];
    int index = 0;
    for(int i = 0; i < n; i++){
      
        if(result[i] > max){ 
            max = result[i]; 
            index = i;
        }
    }

    
    if(max > n / 2){
        printf("%d", arr[index]);
    } else {
        printf("-1");
    }

    return 0;
}
