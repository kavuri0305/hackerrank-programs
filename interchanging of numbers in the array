#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() {

   int n, big=0,small=0; 
   scanf("%d",&n);
   int arr[n];
   for(int i=0; i<n; i++){
    scanf("%d",&arr[i]);
   }
   int max=arr[0];
   int min=arr[0];
   for(int i=0; i<n; i++){
    if(arr[i]>max){
        max=arr[i];
        big=i;
    }
    if(arr[i]<min){
        min=arr[i];
        small=i;
    }
   }
   int temp = arr[big];
    arr[big] = arr[small];
    arr[small] = temp;
   for(int i=0; i<n; i++){

    printf("%d\t",arr[i]);
   }
      
    return 0;
}
