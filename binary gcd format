#include<stdio.h>
int binarygcd(int a, int b){
int count=0;
if(a==0)
return b;
if(b==0)
return a;
while(a%2==0 && b%2==0)
 {
 a=a/2;
 b=b/2;
 count++;
 }
while(a!=b){
if(a>b)
 a=(a-b);
else
  b=(b-a);
  while(a%2==0)
   a=a/2;
   while(b%2==0)
   b=b/2;    
 } 
  if(count!=0)
  return count*2*a;
  else
   return a;    
}
int main(){
int a,b,result;
scanf("%d",&a);
scanf("%d",&b);
result=binarygcd(a,b);
printf("%d",result);
return 0;
}
